# ---------------------------------------------------------------------------
# Copy to .env (or set these in your hosting platform's dashboard).
#
# Leaving every one of these unset keeps the original behaviour: a local Wi-Fi
# exam server that students reach by typing this machine's IP address. Setting
# PUBLIC_URL is what switches it to internet mode.
# ---------------------------------------------------------------------------

# The address students will actually type or scan, as seen from the internet.
# This is the switch: set it and the server treats itself as publicly reachable,
# which turns on HTTPS redirection, HSTS, proxy awareness, and the stricter
# admin password rules below. Leave it unset for a LAN-only exam.
PUBLIC_URL=https://exam.yourschool.edu

# REQUIRED once PUBLIC_URL is set. At least 12 characters, and not guessable -
# the server refuses to start otherwise. Whoever has this can read every answer
# key and every result. Generate one with:  node -p "crypto.randomUUID()"
ADMIN_PASSWORD=

# Where the SQLite database file lives. Point this at a mounted volume on any
# host with an ephemeral filesystem, or a redeploy erases every exam result.
DB_FILE=/data/exam.db

# Port to listen on. Most platforms inject this themselves; leave it unset there.
PORT=3000

# Interface to bind. 0.0.0.0 (the default) is right both on a LAN and inside a
# container. Use 127.0.0.1 when a reverse proxy on the same machine is the only
# thing that should be able to reach the process.
HOST=0.0.0.0

# How many proxy hops to trust for the client's real IP address. The default is
# 1 in internet mode, which is correct for a single load balancer or one
# Cloudflare / nginx in front. Set 2 if you have chained two of them. Getting
# this wrong either lumps every student into one rate-limit bucket, or lets a
# client forge its own address.
# TRUST_PROXY=1

# Redirect http:// to https://. Defaults to on when PUBLIC_URL is an https
# address. Set to 0 only if TLS terminates somewhere that does not send
# X-Forwarded-Proto, where the redirect would otherwise loop forever.
# FORCE_HTTPS=1
